# 복사해서 .env로 저장 후 키를 채우세요: cp .env.example .env
# .env는 git에 안 올라갑니다(.gitignore). 절대 커밋/공유하지 마세요.
# 카테고리별 키가 비어있으면 그 부분만 mock으로 자동 대체됩니다.

USE_MOCK=0

# 서울 열린데이터광장 — 카테고리별 전용 키
SEOUL_KEY_SECURITY_LIGHT=

# CCTV 구별 API는 전부 서비스 종료됨(2026-10-21 확인) — CCTV_STANDARD_FILE로 대체

# 안심귀갓길 서비스(OA-21697) — 안전시설물(OA-21696)은 SHP 파일로 대체해서 키 불필요
SEOUL_KEY_SAFE_ROUTE_SERVICE=

# 카테고리 전용 키가 없을 때 쓰는 공용 폴백키
SEOUL_OPENAPI_KEY=

# 공공데이터포털(data.go.kr) — 편의점/경찰관서 공용키
DATA_GO_KR_KEY=

# 행정안전부_안전비상벨위치정보 조회서비스(15155046) 전용 키
DATA_GO_KR_EMERGENCY_BELL_KEY=

# 생활인구/범죄 통계는 API가 아니라 파일 다운로드 — 받은 파일 경로를 지정
SEOUL_POPULATION_FILE=
SEOUL_CRIME_FILE=

# 안심귀갓길 경로 SHP(OA-21695), 안전시설물 SHP(OA-21696), 전국 CCTV 표준데이터 CSV(15013094) 경로
SEOUL_SAFE_ROUTE_SHP=
ROUTE_FACILITY_SHP=
CCTV_STANDARD_FILE=
